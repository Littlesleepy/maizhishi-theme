{
  "manifest_version": 2,
  "id": "github.littlesleepy.maizhishi-theme",
  "version": "0.1.3",
  "name": "麦之诗(界面风格)",
  "description": "以《影之诗：超凡世界》的美术风格装点界面，淡金边框搭配青白与夜蓝两套配色。",
  "author": {"name": "littlesleepy", "url": "https://github.com/Littlesleepy"},
  "license": "AGPL-3.0-only",
  "urls": {"repository": "https://github.com/Littlesleepy/maizhishi-theme"},
  "host_application": {"min_version": "1.3.18", "max_version": "1.3.18"},
  "sdk": {"min_version": "2.19.0", "max_version": "2.19.0"},
  "dependencies": [{"type": "python_package", "name": "maibot-dashboard", "version_spec": "==1.9.12"}],
  "plugin_type": "other",
  "display": {"icon": {"type": "local", "value": "payload/themes/orchis/native/assets/hd/glyph-card.png", "fallback": "palette"}},
  "capabilities": [],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
